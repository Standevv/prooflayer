[TEMPLATE]
XLAYER_TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# X Layer Testnet certificate issuance is disabled unless this is exactly
# "true". These are single-process development/testnet controls only; they do
# not replace KMS/HSM custody, multisig governance, a durable transaction
# queue, or distributed idempotency in a production deployment.
PROOFLAYER_TESTNET_ISSUANCE_ENABLED=false
# Required only when testnet issuance is enabled. Use a cryptographically
# random bearer token of at least 32 characters. Never bundle it through a
# NEXT_PUBLIC variable or commit it. In the local testnet operator console it
# is entered manually, remains in page memory for one attempt, and is exposed
# to any compromised/XSS script in that page; this is not production IAM.
PROOFLAYER_OPERATOR_TOKEN=
# Non-secret, auditable identity for the one configured testnet operator.
PROOFLAYER_OPERATOR_ID=
# Optional local JSONL path. Defaults to data/issuance/audit.jsonl. This is a
# development audit trace, not a tamper-evident production audit ledger.
PROOFLAYER_ISSUANCE_AUDIT_PATH=
# Ethereum mainnet JSON-RPC endpoint used for live USDY on-chain evidence
# (total supply, deployed-code contract verification). Read-only; any public or
# private Ethereum mainnet endpoint is accepted and validated by chain ID.
# The value below is a public endpoint suitable for local read-only development.
ETHEREUM_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# Example ProofLayer AI provider configuration selects NVIDIA NIM; any
# OpenAI-compatible endpoint works. When AI_PROVIDER=nvidia the agent reads
# NVIDIA_API_KEY as the provider-specific key; AI_API_KEY remains a generic
# override. OPENAI_* fallbacks are supported temporarily for backward
# compatibility.
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Provider-specific key (used when AI_PROVIDER=nvidia)
NVIDIA_API_KEY=
# Generic override (optional; wins only when the provider-specific key is empty)
AI_API_KEY=
# Alternative: OpenRouter
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<model, e.g. nvidia/nemotron-3-ultra-550b-a55b:free>
# OPENROUTER_API_KEY=
# Alternative: Cerebras
# AI_PROVIDER=cerebras
# AI_BASE_URL=https://api.cerebras.ai/v1
# AI_MODEL=gpt-oss-120b
# CEREBRAS_API_KEY=
# Legacy OpenAI fallback (deprecated, use AI_* above)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
PROOFLAYER_AGENT_MAX_TURNS=4
PROOFLAYER_AGENT_HOST=127.0.0.1
PROOFLAYER_AGENT_PORT=8010
