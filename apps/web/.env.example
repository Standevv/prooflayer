NEXT_PUBLIC_XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
PROOFLAYER_AGENT_API_URL=http://127.0.0.1:8010

# Development/testnet issuance boundary. These are server-only variables:
# never prefix them with NEXT_PUBLIC_. Issuance remains disabled by default.
# Use the same exact, randomly generated token (minimum 32 characters) as the API.
# It is server-only configuration; a trusted local operator manually enters the
# matching credential for an issuance attempt. This is not production IAM/RBAC.
PROOFLAYER_TESTNET_ISSUANCE_ENABLED=false
PROOFLAYER_OPERATOR_TOKEN=
